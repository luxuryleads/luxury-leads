# ── Luxury Leads environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in values. NEVER commit real keys.

# ── Database ──────────────────────────────────────────────────────────────
# Production: Postgres. Point this at your Postgres connection string
# (e.g. from Vercel Postgres, Supabase, or Neon):
DATABASE_URL="postgresql://user:password@host:5432/luxuryleads"
#
# Local dev fallback (SQLite, zero setup): comment the line above, flip the
# provider in prisma/schema.prisma back to "sqlite", and use:
# DATABASE_URL="file:./dev.db"

# ── Email (STUBBED until this is set) ───────────────────────────────────────
# The Resend integration is a stub that only sends when this key is present.
# "Connect key to go live." Get one at https://resend.com
RESEND_API_KEY=""
# Optional: the verified sender address Resend will send from.
RESEND_FROM_EMAIL=""

# ── Auth ────────────────────────────────────────────────────────────────────
# Reserved for session signing if we migrate to NextAuth. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"

# ── Stripe (NOT YET INTEGRATED — placeholders) ──────────────────────────────
# Subscription billing is stubbed in this scaffold. Add keys to go live.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Misc ────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for QR codes + email links).
APP_URL="http://localhost:3000"
# Optional: protects POST /api/cron/process-sequences from the public.
CRON_SECRET=""
